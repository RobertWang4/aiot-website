---
import { t, type Lang } from '../../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;

const stats = [
  {
    count: 2008,
    label: t(lang,
      'Działamy od — siedemnaście lat praktyki na halach produkcyjnych polskiego i międzynarodowego przemysłu.',
      'Operating since — seventeen years of plant-floor practice across Polish and international industry.'),
  },
  {
    serif: 'ISO',
    label: t(lang,
      'Certyfikowane systemy zarządzania. Wdrażamy, utrzymujemy i audytujemy — oraz przygotowujemy do certyfikacji.',
      'Certified management systems. We implement, maintain and audit them — and prepare you for certification.'),
  },
  {
    text: 'PCA',
    label: t(lang,
      'Akredytowane laboratorium pomiarowe. Pomiary elektryczne, termowizja i diagnostyka stanowisk pracy.',
      'Accredited measurement laboratory. Electrical testing, thermal imaging and workstation diagnostics.'),
  },
];
---
<div class="stats">
  {stats.map((s, i) => (
    <div class="stat reveal" style={`transition-delay:${i * 0.12}s`}>
      <b data-count={s.count}>{s.serif ? <em>{s.serif}</em> : s.text ?? '0'}</b>
      <p>{s.label}</p>
    </div>
  ))}
</div>

<style>
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line);
    border-block: 1px solid var(--line); }
  .stat { background: var(--paper); padding: clamp(36px, 6vw, 72px) clamp(20px, 3.4vw, 48px); }
  .stat b { display: block; font-weight: 300; font-size: clamp(46px, 7vw, 96px); letter-spacing: -0.05em;
    line-height: 1; color: var(--navy); }
  .stat b em { font-family: var(--serif); font-style: italic; color: var(--blue); }
  .stat p { margin-top: 14px; font-size: 13.5px; color: var(--muted); max-width: 28ch; }
  @media (max-width: 760px) { .stats { grid-template-columns: 1fr; } }
</style>

<script>
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    const el = e.target as HTMLElement;
    const end = Number(el.dataset.count);
    io.unobserve(el);
    if (RM) { el.textContent = String(end); return; }
    const t0 = performance.now(), dur = 1500;
    const step = (t: number) => {
      const p = Math.min(1, (t - t0) / dur), k = 1 - Math.pow(1 - p, 4);
      el.textContent = String(Math.round(1990 + (end - 1990) * k));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }), { threshold: 0.6 });
  document.querySelectorAll('[data-count]').forEach((n) => io.observe(n));
</script>
