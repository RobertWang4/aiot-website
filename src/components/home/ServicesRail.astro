---
import { t, type Lang } from '../../lib/content';

interface Props { lang: Lang; cards: { title: string; text: string }[] }
const { lang, cards } = Astro.props;

/* home.json card order → services-page anchor + photo (same picks as the approved demo) */
const MAP: [string, string][] = [
  ['machinery', 'emergency-machine-stop-button-2026-01-09-10-40-43-utc.jpg'],
  ['ohs', 'portrait-of-confident-factory-manager-with-diverse-2026-01-09-11-12-24-utc.jpg'],
  ['fire-safety', 'fire-fighter-team-on-training-with-gas-and-oil-fir-2026-03-09-09-01-40-utc.jpg'],
  ['adr', 'modern-conveyor-system-with-boxes-in-motion-2026-01-08-05-12-48-utc.jpg'],
  ['environment', 'inspector-examination-of-photovoltaic-modules-usin-2026-01-09-00-13-33-utc.jpg'],
  ['parts-processing', 'close-up-of-cnc-machine-cutting-metal-2026-01-07-07-11-17-utc.jpg'],
  ['workplace-measurements', 'male-electrician-working-in-a-switchboard-with-fus-2026-01-08-23-45-13-utc.jpg'],
  ['occupational-medicine', 'man-and-woman-doctors-are-standing-together-indoor-2026-01-09-00-02-25-utc.jpg'],
  ['employment-agency', 'diverse-people-in-a-seminar-2026-01-07-07-26-02-utc.jpg'],
  ['iso', '53732-machinery-in-laboratory-2026-01-09-11-39-55-utc.jpg'],
];
const total = String(cards.length).padStart(2, '0');
---
<div class="rail-wrap">
  <div class="rail" id="rail" data-total={cards.length}>
    {cards.map((c, i) => (
      <a class="card" href={`/${lang}/services/#${MAP[i]?.[0] ?? ''}`}>
        <img src={`/img/gallery/${MAP[i]?.[1] ?? MAP[0][1]}`} alt={c.title} loading="lazy" />
        <div>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
          <span class="more">{t(lang, 'Dowiedz się więcej', 'Read more')}</span>
        </div>
      </a>
    ))}
  </div>
  <div class="railbar">
    <span>{t(lang, 'Przeciągnij', 'Drag')}</span>
    <div class="track"><i id="trackbar"></i></div>
    <span id="railidx">01 / {total}</span>
  </div>
</div>

<style>
  .rail-wrap { padding-bottom: clamp(70px, 11vh, 140px); }
  .card {
    scroll-snap-align: start; flex: 0 0 clamp(240px, 27vw, 352px);
    height: clamp(400px, 56vh, 540px); position: relative; overflow: hidden; border-radius: 3px;
    background: var(--navy); isolation: isolate;
  }
  .card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.1s var(--ease), filter 0.8s var(--ease); filter: saturate(0.55) contrast(1.06); }
  .card:hover img { transform: scale(1.06); filter: saturate(1) contrast(1.02); }
  .card::after { content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(8, 11, 20, 0.14) 0%, rgba(8, 11, 20, 0.32) 42%, rgba(8, 11, 20, 0.92) 100%); }
  .card > div { position: absolute; inset: auto 0 0 0; z-index: 2; padding: 26px 24px 24px; color: #fff; }
  .card .num { font-family: var(--serif); font-style: italic; font-size: 28px; color: #9fbbff;
    display: block; margin-bottom: 10px; line-height: 1; }
  .card h3 { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.18;
    text-transform: uppercase; margin: 0; }
  .card p { font-size: 13px; line-height: 1.5; color: rgba(255, 255, 255, 0.68); margin: 0;
    max-height: 0; opacity: 0; overflow: hidden;
    transition: max-height 0.7s var(--ease), opacity 0.5s, margin 0.7s var(--ease); }
  .card:hover p, .card:focus-visible p { max-height: 11em; opacity: 1; margin-top: 10px; }
  .card .more { display: inline-block; margin-top: 14px; font-size: 11px; letter-spacing: 0.16em;
    text-transform: uppercase; font-weight: 600; color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4); padding-bottom: 2px; }
</style>

<script>
  const rail = document.getElementById('rail') as HTMLElement | null;
  if (rail) {
    const bar = document.getElementById('trackbar') as HTMLElement;
    const idx = document.getElementById('railidx') as HTMLElement;
    const total = Number(rail.dataset.total);
    const pad = (n: number) => String(n).padStart(2, '0');
    let down = false, sx = 0, sl = 0, moved = 0;
    rail.addEventListener('pointerdown', (e) => {
      down = true; moved = 0; sx = e.clientX; sl = rail.scrollLeft;
      rail.classList.add('drag'); rail.setPointerCapture(e.pointerId);
    });
    rail.addEventListener('pointermove', (e) => {
      if (!down) return;
      const d = e.clientX - sx;
      moved = Math.max(moved, Math.abs(d));
      rail.scrollLeft = sl - d;
    });
    const up = () => { down = false; rail.classList.remove('drag'); };
    rail.addEventListener('pointerup', up);
    rail.addEventListener('pointercancel', up);
    // a drag should not follow the card link
    rail.addEventListener('click', (e) => { if (moved > 6) { e.preventDefault(); moved = 0; } }, true);
    rail.addEventListener('scroll', () => {
      const max = rail.scrollWidth - rail.clientWidth, p = max > 0 ? rail.scrollLeft / max : 0;
      const track = bar.parentElement as HTMLElement;
      bar.style.transform = `translateX(${p * (track.clientWidth * 0.82)}px)`;
      idx.textContent = `${pad(Math.min(total, Math.round(p * (total - 1)) + 1))} / ${pad(total)}`;
    }, { passive: true });
  }
</script>
