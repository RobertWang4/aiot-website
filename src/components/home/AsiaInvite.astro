---
import { t, type Lang } from '../../lib/content';
interface Props { lang: Lang; asia: { headline: string; cta: string; lines: string[] } }
const { lang, asia } = Astro.props;
const rotation = [asia.headline, ...asia.lines];
---
<div class="invite">
  <div>
    <span class="eyebrow">{t(lang, 'Współpraca', 'Partnership')}</span>
    <div class="rot" data-rotate={JSON.stringify(rotation)}><span>{asia.headline}</span></div>
  </div>
  <a href={`/${lang}/contact/`}>{asia.cta}</a>
</div>

<style>
  .invite { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    padding: clamp(50px, 8vh, 96px) var(--pad); display: flex; flex-wrap: wrap;
    gap: 28px; align-items: baseline; justify-content: space-between; }
  .rot { font-size: clamp(24px, 3.6vw, 52px); font-weight: 300; letter-spacing: -0.03em;
    line-height: 1.1; min-height: 1.15em; color: var(--navy); margin-top: 14px; }
  .rot span { display: inline-block; transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
  .rot span.out { opacity: 0; transform: translateY(-14px); }
  .invite > a { font-size: 13px; font-weight: 600; color: var(--blue);
    border-bottom: 1px solid currentColor; padding-bottom: 3px; white-space: nowrap; }
</style>

<script>
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rot = document.querySelector<HTMLElement>('[data-rotate]');
  if (rot && !RM) {
    const lines: string[] = JSON.parse(rot.dataset.rotate!);
    const el = rot.querySelector('span')!;
    let i = 0;
    setInterval(() => {
      el.classList.add('out');
      setTimeout(() => { i = (i + 1) % lines.length; el.textContent = lines[i]; el.classList.remove('out'); }, 700);
    }, 3800);
  }
</script>
