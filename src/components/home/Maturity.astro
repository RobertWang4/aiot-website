---
import { splitAccent } from './accent';

interface Props {
  maturity: {
    eyebrow: string; headline: string;
    axis: { high: string; label: string; low: string };
    stages: { name: string; text: string; management: string }[];
  };
}
const { maturity: m } = Astro.props;
const [lead, accent] = splitAccent(m.headline);
---
<section class="matrix">
  <div class="bg">
    <img src="/img/gallery/engineer-fixing-a-mechanical-arm-on-an-industrial-2026-03-16-02-31-03-utc.jpg" alt="" loading="lazy" />
  </div>
  <div class="band-in">
    <span class="eyebrow eyebrow-l reveal">{m.eyebrow}</span>
    <h2 class="h2 reveal" style="transition-delay:.08s">{lead}{lead && ' '}<span class="it">{accent}</span></h2>
    <div class="axis">
      <span>← {m.axis.high} {m.axis.label.toLowerCase()}</span>
      <span>{m.axis.low} →</span>
    </div>
    <div class="stages">
      {m.stages.map((s, i) => (
        <div class="stage">
          <div class="bar"></div>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
          <div class="mgmt">{s.management}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .matrix { position: relative; background: var(--ink); color: #fff; }
  .bg { position: absolute; inset: 0; overflow: hidden; }
  .bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.3; filter: grayscale(0.5); }
  .bg::after { content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, var(--ink), rgba(11, 27, 74, 0.72) 50%, var(--ink)); }
  .band-in { position: relative; z-index: 2; padding: clamp(84px, 13vh, 168px) var(--pad); }
  .band-in h2 { color: #fff; margin-top: 18px; max-width: 18ch; }
  .band-in h2 :global(.it) { color: #9fbbff; }
  .axis { display: flex; justify-content: space-between; gap: 16px; font-size: 10px; letter-spacing: 0.24em;
    text-transform: uppercase; color: rgba(255, 255, 255, 0.4); margin: 52px 0 0; padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15); }
  .stages { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: rgba(255, 255, 255, 0.14); }
  .stage { background: var(--ink); padding: 30px 22px 34px; position: relative;
    opacity: 0.26; transform: translateY(14px);
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease), background 0.9s var(--ease); }
  .stage.lit { opacity: 1; transform: none; background: rgba(47, 107, 255, 0.07); }
  .stage .bar { height: 3px; background: var(--blue); width: 0; transition: width 1.1s var(--ease); margin-bottom: 22px; }
  .stage.lit .bar { width: 100%; }
  .stage .n { font-family: var(--serif); font-style: italic; font-size: 34px; color: #9fbbff; line-height: 1; }
  .stage h3 { font-size: 15.5px; font-weight: 600; letter-spacing: 0; margin: 12px 0; line-height: 1.2; }
  .stage p { font-size: 12.5px; line-height: 1.55; color: rgba(255, 255, 255, 0.62); margin: 0; }
  .stage .mgmt { margin-top: 14px; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.13);
    font-size: 12px; color: rgba(255, 255, 255, 0.46); font-style: italic; }
  @media (max-width: 900px) { .stages { grid-template-columns: 1fr; } .stage { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) {
    .stage { opacity: 1; transform: none; }
    .stage .bar { width: 100%; }
  }
</style>

<script>
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    const n = [...(e.target.parentElement as HTMLElement).children].indexOf(e.target);
    setTimeout(() => e.target.classList.add('lit'), n * 160);
    io.unobserve(e.target);
  }), { threshold: 0.45 });
  document.querySelectorAll('.stage').forEach((n) => io.observe(n));
</script>
