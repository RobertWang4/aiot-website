---
import { site, t, type Lang } from '../../lib/content';
import { splitAccent } from './accent';

interface Props {
  lang: Lang;
  closing: {
    eyebrow: string; headline: string;
    values: { title: string; text: string }[];
    chain: string[];
  };
}
const { lang, closing } = Astro.props;
const [lead, accent] = splitAccent(closing.headline, 3);

/* EN home.json ships an empty `values` array — fall back to the approved English copy */
const EN_VALUES = [
  { title: 'Complete operational relief', text: 'Outsourcing that works for you.' },
  { title: 'Development partner', text: 'We support companies that want to go further.' },
  { title: 'Safety culture', text: 'With people in mind. With a passion for OHS.' },
  { title: 'Pragmatic solutions', text: 'A pragmatic approach. Real value.' },
];
const values = closing.values.length ? closing.values : EN_VALUES;
---
<section class="close">
  <div class="bg">
    <img data-para src="/img/gallery/engineer-work-at-robotic-arm-factory-2026-03-10-01-10-42-utc.jpg" alt="" loading="lazy" />
  </div>
  <div class="band-in">
    <span class="eyebrow eyebrow-l reveal">{closing.eyebrow}</span>
    <h2 class="h2 reveal" style="transition-delay:.08s">{lead}{lead && ' '}<span class="it">{accent}</span></h2>

    <div class="values">
      {values.map((v, i) => (
        <div class="reveal" style={`transition-delay:${0.1 + i * 0.08}s`}>
          <h3>{v.title}</h3>
          <p>{v.text}</p>
        </div>
      ))}
    </div>

    <div class="chain" id="chain">
      {closing.chain.map((c, i) => (
        <>
          {i > 0 && <s>→</s>}
          <b>{c}</b>
        </>
      ))}
    </div>

    <a href={`mailto:${site.contact.email}`} class="btn btn-p reveal">
      {t(lang, 'Zacznijmy rozmowę', 'Start the conversation')} <i>→</i>
    </a>
  </div>
</section>

<style>
  .close { position: relative; min-height: 100svh; display: flex; align-items: center;
    overflow: hidden; background: var(--ink); padding: clamp(90px, 14vh, 150px) var(--pad); }
  .bg { position: absolute; inset: 0; }
  .bg img { width: 100%; height: 112%; object-fit: cover; opacity: 0.5; will-change: transform; }
  .bg::after { content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(8, 11, 20, 0.92), rgba(11, 27, 74, 0.78) 55%, rgba(8, 11, 20, 0.95)); }
  .band-in { position: relative; z-index: 2; width: 100%; }
  .band-in h2 { color: #fff; max-width: 15ch; margin: 20px 0 0; }
  .band-in h2 :global(.it) { color: #9fbbff; }

  .values { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    background: rgba(255, 255, 255, 0.14); margin-top: clamp(44px, 7vh, 78px); }
  .values > div { background: rgba(8, 11, 20, 0.45); padding: 26px 22px 30px; }
  .values h3 { font-size: 14px; font-weight: 600; letter-spacing: 0; color: #fff; margin: 0 0 8px; }
  .values p { font-size: 13px; line-height: 1.55; color: rgba(255, 255, 255, 0.6); margin: 0; }
  @media (max-width: 900px) { .values { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .values { grid-template-columns: 1fr; } }

  .chain { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(8px, 1.3vw, 20px);
    margin: clamp(36px, 6vh, 62px) 0 42px; }
  .chain b { font-weight: 500; font-size: clamp(13px, 1.35vw, 17px); color: #fff; letter-spacing: 0.01em;
    border: 1px solid rgba(255, 255, 255, 0.22); border-radius: 100px; padding: 9px 18px;
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
  .chain.in b { opacity: 1; transform: none; }
  .chain s { text-decoration: none; color: var(--blue); font-size: 15px; }
  .chain b:last-of-type { background: var(--blue); border-color: var(--blue); }
  @media (prefers-reduced-motion: reduce) { .chain b { opacity: 1; transform: none; } }
</style>

<script>
  const chain = document.getElementById('chain');
  if (chain) {
    new IntersectionObserver((es, o) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      chain.classList.add('in');
      [...chain.querySelectorAll('b')].forEach((n, i) => { n.style.transitionDelay = i * 0.1 + 's'; });
      o.disconnect();
    }), { threshold: 0.4 }).observe(chain);
  }
</script>
