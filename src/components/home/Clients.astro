---
import { t, type Lang } from '../../lib/content';
interface Props { lang: Lang; heading: string; logos: { src: string; alt: string }[] }
const { lang, heading, logos } = Astro.props;
---
<section class="clients">
  <div class="lbl">
    <h3 class="reveal">{heading}</h3>
    <span class="eyebrow reveal" style="transition-delay:.1s">{t(lang, 'Wybrani klienci', 'Selected clients')}</span>
  </div>
  <div class="logos">
    <div>{logos.map((l) => <img src={l.src} alt={l.alt} loading="lazy" />)}</div>
    <div aria-hidden="true">{logos.map((l) => <img src={l.src} alt="" loading="lazy" />)}</div>
  </div>
</section>

<style>
  .clients { padding: clamp(70px, 11vh, 130px) 0; border-top: 1px solid var(--line); }
  .lbl { padding: 0 var(--pad); margin-bottom: 44px; display: flex; flex-wrap: wrap; gap: 16px;
    justify-content: space-between; align-items: baseline; }
  .lbl h3 { font-size: clamp(22px, 2.6vw, 34px); font-weight: 300; letter-spacing: -0.03em; margin: 0; }
  .logos { display: flex; overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
  .logos > div { display: flex; flex: none; align-items: center; animation: mq-slide 46s linear infinite; }
  .logos:hover > div { animation-play-state: paused; }
  .logos img { height: clamp(30px, 3.4vw, 44px); width: clamp(96px, 11vw, 148px); object-fit: contain;
    margin: 0 clamp(20px, 2.6vw, 40px); mix-blend-mode: multiply;
    filter: grayscale(1) opacity(0.55) contrast(0.95); transition: filter 0.5s var(--ease); }
  .logos img:hover { filter: none; }
</style>
