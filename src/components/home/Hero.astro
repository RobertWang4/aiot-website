---
import { t, type Lang } from '../../lib/content';
import { splitAccent } from './accent';

interface Props {
  lang: Lang;
  eyebrow: string;
  headline: string;
  ctas: { label: string; href: string }[];
  img: string;
  alt: string;
}
const { lang, eyebrow, headline, ctas, img, alt } = Astro.props;
const [lead, accent] = splitAccent(headline);
---
<section class="hero">
  <div class="shot"><img class="kb" src={img} alt={alt} fetchpriority="high" /></div>
  <div class="hero-in">
    <span class="eyebrow eyebrow-l reveal">{eyebrow}</span>
    <h1 class="h1 reveal" style="transition-delay:.1s">{lead}{lead && ' '}<span class="it">{accent}</span></h1>
    <div class="hero-row reveal" style="transition-delay:.24s">
      {ctas.map((c, i) => (
        <a href={c.href} class:list={['btn', i === 0 ? 'btn-p' : 'btn-g']}>
          {c.label}{i === 0 && <i>→</i>}
        </a>
      ))}
    </div>
  </div>
  <div class="cue">{t(lang, 'Przewiń', 'Scroll')}</div>
</section>

<style>
  .hero { position: relative; height: 100svh; min-height: 600px; overflow: hidden; background: var(--ink); }
  .shot { position: absolute; inset: 0; }
  .shot img { width: 100%; height: 100%; object-fit: cover; opacity: 0.92; }
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, rgba(8, 11, 20, 0.72) 0%, rgba(8, 11, 20, 0.18) 34%, rgba(8, 11, 20, 0.55) 74%, rgba(8, 11, 20, 0.94) 100%),
      linear-gradient(96deg, rgba(11, 27, 74, 0.82) 0%, rgba(11, 27, 74, 0.1) 62%);
  }
  .hero-in {
    position: relative; z-index: 2; height: 100%;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 0 var(--pad) clamp(46px, 8vh, 92px);
  }
  .hero-in h1 { color: #fff; max-width: 20ch; margin: 18px 0 0; }
  .hero-in h1 :global(.it) { color: #bfd1ff; }
  .hero-row { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: clamp(28px, 4vh, 44px); }
  .cue {
    position: absolute; z-index: 2; right: var(--pad); bottom: clamp(46px, 8vh, 92px);
    writing-mode: vertical-rl; font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5); display: flex; align-items: center; gap: 14px;
  }
  .cue::after {
    content: ''; width: 1px; height: 64px;
    background: linear-gradient(rgba(255, 255, 255, 0.5), transparent);
    animation: drip 2.4s var(--ease) infinite;
  }
  @keyframes drip {
    0% { transform: scaleY(0.2); transform-origin: top; }
    60%, 100% { transform: scaleY(1); transform-origin: top; }
  }
  @media (max-width: 700px) { .cue { display: none; } }
</style>
