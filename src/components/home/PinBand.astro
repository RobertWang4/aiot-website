---
import { splitAccent } from './accent';

interface Props { eyebrow: string; headline: string; img: string; alt: string; id?: string }
const { eyebrow, headline, img, alt, id } = Astro.props;
const [lead, accent] = splitAccent(headline);
---
<section class="pin" id={id}>
  <div class="stick">
    <img data-para src={img} alt={alt} loading="lazy" />
    <div class="copy">
      <div>
        <span class="eyebrow eyebrow-l reveal">{eyebrow}</span>
        <h2 class="h2 reveal" style="transition-delay:.08s">{lead}{lead && ' '}<span class="it">{accent}</span></h2>
      </div>
    </div>
  </div>
</section>

<style>
  .pin { position: relative; height: 190vh; }
  .stick { position: sticky; top: 0; height: 100svh; overflow: hidden; background: var(--ink); }
  .stick img { width: 100%; height: 118%; object-fit: cover; will-change: transform; }
  .stick::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(8, 11, 20, 0.9) 0%, rgba(8, 11, 20, 0.45) 55%, rgba(11, 27, 74, 0.35) 100%);
  }
  .copy { position: absolute; inset: 0; z-index: 2; display: flex; align-items: center; padding: 0 var(--pad); }
  .copy > div { max-width: 22ch; }
  .copy h2 { color: #fff; margin: 18px 0 0; }
  .copy h2 :global(.it) { color: #9fbbff; }
</style>
