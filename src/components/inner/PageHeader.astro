---
/** Light page header: white type block, then an optional full-width photo band. */
interface Props {
  eyebrow?: string;
  eyebrowHref?: string;
  title: string;
  lede?: string;
  image?: string;
  alt?: string;
}
const { eyebrow, eyebrowHref, title, lede, image, alt = '' } = Astro.props;
---
<header class="ph">
  <div class="ph-in wrap">
    {eyebrow && (
      <p class="ph-eyebrow reveal">
        {eyebrowHref ? <a href={eyebrowHref}>{eyebrow}</a> : eyebrow}
      </p>
    )}
    <h1 class="ph-title reveal">{title}</h1>
    {lede && <p class="ph-lede reveal">{lede}</p>}
    <slot />
  </div>
</header>
{image && (
  <div class="ph-band">
    <img src={image} alt={alt} />
  </div>
)}

<style>
  .ph { border-bottom: 1px solid var(--line); }
  .ph-in { padding-block: clamp(56px, 9vw, 140px); }
  .ph-eyebrow {
    font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 20px;
  }
  .ph-eyebrow a { border-bottom: 1px solid var(--line); padding-bottom: 3px; transition: color 0.25s, border-color 0.25s; }
  .ph-eyebrow a:hover { color: var(--blue); border-color: var(--blue); }
  .ph-title {
    margin: 0; max-width: 19ch;
    font-size: clamp(34px, 5.2vw, 72px); font-weight: 700;
    letter-spacing: -0.035em; line-height: 1.03; text-wrap: balance;
  }
  .ph-lede {
    margin: 26px 0 0; max-width: 62ch; color: var(--muted);
    font-size: clamp(15.5px, 1.2vw, 18px); line-height: 1.65;
  }
  .ph-band { height: clamp(280px, 46vw, 640px); overflow: hidden; background: #f4f5f7; }
  .ph-band img { width: 100%; height: 100%; object-fit: cover; }
</style>
