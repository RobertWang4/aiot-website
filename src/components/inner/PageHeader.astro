---
/** Light page header: white type block, then an optional full-width photo band. */
interface Props {
  eyebrow?: string;
  eyebrowHref?: string;
  title: string;
  lede?: string;
  image?: string;
  alt?: string;
}
const { eyebrow, eyebrowHref, title, lede, image, alt = '' } = Astro.props;
---
<header class="ph">
  <div class="ph-in wrap">
    {eyebrow && (
      <p class="ph-eyebrow reveal">
        {eyebrowHref ? <a href={eyebrowHref}>{eyebrow}</a> : eyebrow}
      </p>
    )}
    <h1 class="ph-title reveal">{title}</h1>
    {lede && <p class="ph-lede reveal">{lede}</p>}
    <slot />
  </div>
</header>
{image && (
  <div class="ph-band">
    <img src={image} alt={alt} />
  </div>
)}

<style>
  .ph { border-bottom: 1px solid var(--line); }
  .ph-in { padding-block: clamp(56px, 9vw, 140px); }
  .ph-eyebrow {
    font-family: var(--mono); font-size: 12px; font-weight: 400;
    letter-spacing: 0.12em; text-transform: uppercase; font-variant-numeric: tabular-nums;
    color: var(--faint); margin: 0 0 24px;
  }
  .ph-eyebrow a { border-bottom: 1px solid var(--line); padding-bottom: 3px; transition: color 0.2s, border-color 0.2s; }
  .ph-eyebrow a:hover { color: var(--blue); border-color: var(--blue); }
  .ph-title {
    margin: 0; max-width: 19ch; font-family: var(--display);
    font-size: clamp(40px, 6vw, 84px); font-weight: 700;
    letter-spacing: -0.025em; line-height: 1.02; text-wrap: balance;
  }
  .ph-lede {
    margin: 28px 0 0; max-width: 52ch; color: var(--muted);
    font-size: clamp(17px, 1.4vw, 20px); line-height: 1.6;
  }
  .ph-band { height: clamp(280px, 46vw, 640px); overflow: hidden; background: var(--surface); }
  .ph-band img { width: 100%; height: 100%; object-fit: cover; }
</style>
