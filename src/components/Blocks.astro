---
/** Renders a generic block array (about / contact / service pages). */
import type { Block } from '../lib/content';
interface Props { blocks: Block[]; class?: string }
const { blocks: raw, class: cls = '' } = Astro.props;

// The scraped content sometimes stacks two section headings in a row. Read the
// first one as the label of the second instead of rendering an orphan title.
const blocks: Block[] = [];
for (let i = 0; i < raw.length; i++) {
  const b = raw[i];
  const nxt = raw[i + 1];
  if (b.type === 'heading' && b.level <= 2 && !b.eyebrow && nxt?.type === 'heading' && nxt.level <= 2 && !nxt.eyebrow) {
    blocks.push({ ...nxt, eyebrow: b.text });
    i++;
    continue;
  }
  blocks.push(b);
}
// a heading with nothing under it is a scraping artefact, not a section
while (blocks.length && blocks[blocks.length - 1].type === 'heading') blocks.pop();
const H = (l: number) => (l <= 2 ? 'h2' : l === 3 ? 'h3' : 'h4') as 'h2' | 'h3' | 'h4';
---
<div class:list={['blocks', cls]}>
  {blocks.map((b) => {
    if (b.type === 'heading') {
      const Tag = H(b.level);
      return (
        <div class="reveal b-head">
          {b.eyebrow && <p class="b-eyebrow">{b.eyebrow}</p>}
          <Tag>{b.text}</Tag>
        </div>
      );
    }
    if (b.type === 'paragraph') return <p class="reveal b-p">{b.text}</p>;
    if (b.type === 'list') {
      const Tag = b.ordered ? 'ol' : 'ul';
      return (
        <Tag class:list={['reveal b-list', b.ordered ? 'b-ol' : 'b-ul']}>
          {b.items.map((i) => <li>{i}</li>)}
        </Tag>
      );
    }
    if (b.type === 'image') return <img src={b.src} alt={b.alt} loading="lazy" class="reveal b-img" />;
    if (b.type === 'cta') return <a href={b.href} class="reveal b-cta">{b.label}<i>→</i></a>;
  })}
</div>

<style>
  .blocks { color: var(--ink); }
  .blocks > * + * { margin-top: 18px; }

  .b-head { margin-top: clamp(44px, 5vw, 72px); }
  .b-head:first-child { margin-top: 0; }
  .b-eyebrow {
    margin-bottom: 14px;
    font-family: var(--mono); font-size: 12px; font-weight: 400;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--faint);
  }
  .b-head :global(h2) {
    font-family: var(--display); font-size: clamp(26px, 2.8vw, 36px);
    font-weight: 700; letter-spacing: -.025em; line-height: 1.08;
    color: var(--ink); max-width: 24ch; text-wrap: balance;
  }
  .b-head :global(h3) {
    font-family: var(--display); font-size: 24px;
    font-weight: 700; letter-spacing: -.02em; line-height: 1.15;
    color: var(--ink);
  }
  .b-head :global(h4) {
    font-family: var(--mono); font-size: 12px; font-weight: 500;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--faint);
  }
  .b-head + .b-p { margin-top: 16px; }
  .b-head:has(h3) + .b-p, .b-head:has(h4) + .b-p { margin-top: 10px; }
  .b-head:has(h3), .b-head:has(h4) { margin-top: clamp(28px, 3vw, 40px); }

  .b-p {
    font-size: 16px; line-height: 1.6; color: var(--muted); max-width: 68ch;
  }

  .b-list { max-width: 68ch; list-style: none; counter-reset: b; padding: 0; }
  .b-list li {
    position: relative;
    padding-left: 32px; padding-block: 12px;
    font-size: 16px; line-height: 1.6; color: var(--muted);
    border-top: 1px solid var(--line);
  }
  .b-list li:last-child { border-bottom: 1px solid var(--line); }
  .b-ul li::before {
    content: ""; position: absolute; left: 0; top: 1.15em;
    width: 16px; height: 1px; background: var(--faint);
  }
  .b-ol li { counter-increment: b; }
  .b-ol li::before {
    content: counter(b, decimal-leading-zero);
    position: absolute; left: 0; top: 13px;
    font-family: var(--mono); font-size: 12px; font-weight: 500;
    letter-spacing: .12em; font-variant-numeric: tabular-nums; color: var(--faint);
  }

  .b-img {
    margin-top: clamp(32px, 4vw, 56px);
    width: 100%; object-fit: cover; border-radius: var(--r-sm);
  }

  .b-cta {
    display: inline-flex; align-items: center; gap: 10px;
    margin-top: 32px; padding: 14px 26px;
    background: var(--blue); color: #fff; border-radius: var(--r-md);
    font-size: 15px; font-weight: 600;
    transition: background .2s;
  }
  .b-cta i { font-style: normal; }
  .b-cta:hover { background: var(--blue-hover); }
</style>
