---
import Base from '../../../layouts/Base.astro';
import Blocks from '../../../components/Blocks.astro';
import { LANGS, listServices, getServiceIndex, getService, sentenceCase, t, type Lang } from '../../../lib/content';

export const getStaticPaths = () =>
  LANGS.flatMap((lang) => listServices(lang).map((s) => ({ params: { lang, slug: s.id }, props: { service: s } })));

const lang = Astro.params.lang as Lang;
const { service: s } = Astro.props;
const cat = getServiceIndex(lang).categories.find((c) => c.id === s.category)!;
const catLabel = sentenceCase(cat.label);
const siblings = cat.services.map((id) => getService(lang, id)).filter((x) => x.hasPage);

// the description is a truncated copy of the first paragraph — show only one of them
const key = (s.description ?? '').replace(/[….]+$/, '').trim().slice(0, 45);
const dup = key.length > 25 && s.blocks.some((b) => b.type === 'paragraph' && b.text.startsWith(key));
const lede = dup ? undefined : s.description;
---
<Base lang={lang} title={s.title} description={s.description}>
  <div class="wrap crumb">
    <a href={`/${lang}/services/`}>{t(lang, 'Oferta', 'Services')}</a>
    <span>/</span>
    <a href={`/${lang}/services/c/${cat.id}/`}>{catLabel}</a>
  </div>

  <div class="wrap layout">
    <article>
      <h1 class="title">{s.title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <div class="body"><Blocks blocks={s.blocks} /></div>
      <a href={`/${lang}/contact/`} class="btn btn-p ask">{t(lang, 'Zapytaj o tę usługę', 'Ask about this service')}<i>→</i></a>
    </article>

    <aside>
      <p class="aside-h">{catLabel}</p>
      <ul>
        {siblings.map((x) => (
          <li>
            <a href={`/${lang}/services/${x.id}/`} class:list={['sib', x.id === s.id && 'here']}>
              {x.menuLabel ?? x.title}
            </a>
          </li>
        ))}
      </ul>
      <a href={`/${lang}/services/c/${cat.id}/`} class="back">{t(lang, 'Wróć do dziedziny', 'Back to category')}</a>
    </aside>
  </div>
</Base>

<style>
  .crumb {
    display: flex; align-items: center; gap: 9px; flex-wrap: wrap;
    padding-top: clamp(24px, 3vw, 40px);
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--faint);
  }
  .crumb a { transition: color 0.2s; }
  .crumb a:hover { color: var(--blue); }
  .crumb span { color: var(--line); }

  .layout {
    display: grid; grid-template-columns: minmax(0, 1fr) 240px;
    gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(28px, 4vw, 52px) clamp(64px, 9vw, 128px);
    align-items: start;
  }
  .title {
    margin: 0; max-width: 22ch; font-family: var(--display);
    font-size: clamp(30px, 3.8vw, 52px); font-weight: 700;
    letter-spacing: -0.025em; line-height: 1.04; text-wrap: balance;
  }
  .lede { margin: 24px 0 0; max-width: 52ch; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.6; color: var(--muted); }
  .body { margin-top: clamp(32px, 4vw, 52px); max-width: 68ch; }
  .ask { margin-top: clamp(36px, 4vw, 56px); }

  aside { position: sticky; top: calc(var(--nav-h) + 24px); }
  .aside-h {
    margin: 0 0 18px; font-family: var(--mono); font-size: 12px; font-weight: 400;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint);
  }
  aside ul { list-style: none; margin: 0; padding: 0; }
  aside li { border-top: 1px solid var(--line); }
  aside li:last-child { border-bottom: 1px solid var(--line); }
  .sib { display: block; padding: 11px 0; font-size: 14px; line-height: 1.45; color: var(--muted); transition: color 0.2s; }
  .sib:hover { color: var(--blue); }
  .sib.here { color: var(--ink); font-weight: 600; }
  .back {
    display: inline-block; margin-top: 22px; padding-bottom: 3px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--faint); transition: color 0.2s, border-color 0.2s;
  }
  .back:hover { color: var(--blue); border-color: var(--blue); }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    aside { position: static; order: 2; }
  }
</style>
