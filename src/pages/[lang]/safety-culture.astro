---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/inner/PageHeader.astro';
import { LANGS, getHome, sentenceCase, t, type Lang } from '../../lib/content';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const h = getHome(lang);
const { maturity, noBlame, closing } = h;
const photo = '/img/gallery/leading-his-team-to-greatness-2026-03-25-06-32-55-utc.jpg';
---
<Base
  lang={lang}
  title={sentenceCase(maturity.headline)}
  description={sentenceCase(maturity.eyebrow)}
>
  <PageHeader
    eyebrow={t(lang, 'Kultura bezpieczeństwa', 'Safety culture')}
    title={sentenceCase(maturity.headline)}
    lede={sentenceCase(maturity.eyebrow)}
    image={photo}
    alt={t(lang, 'Zespół na hali produkcyjnej', 'A team on the shop floor')}
  />

  <!-- maturity stages -->
  <section class="sec">
    <div class="wrap">
      <p class="axis reveal">
        <span>{maturity.axis.high}</span>
        <span class="axis-rule"></span>
        <span>{maturity.axis.label}</span>
        <span class="axis-rule"></span>
        <span>{maturity.axis.low}</span>
      </p>
      <ol class="stages">
        {maturity.stages.map((s, i) => (
          <li class="reveal">
            <span class="stage-n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2>{s.name}</h2>
              <p>{s.text}</p>
              {s.management && <p class="mgmt">{s.management}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- no-blame phrases -->
  <section class="band">
    <div class="wrap">
      <h2 class="h2 reveal">{noBlame.headline}</h2>
      <div class="phrases">
        {noBlame.phrases.map((p) => <p class="phrase reveal">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- closing -->
  <section class="sec">
    <div class="wrap">
      <p class="eyebrow reveal">{sentenceCase(closing.eyebrow)}</p>
      <h2 class="h2 close-h reveal">{closing.headline}</h2>

      {closing.values.length > 0 && (
        <div class="values">
          {closing.values.map((v) => (
            <div class="value reveal">
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))}
        </div>
      )}

      <ol class="chain reveal">
        {closing.chain.map((c) => <li>{c}</li>)}
      </ol>

      <a href={`/${lang}/contact/`} class="btn btn-p chain-cta">{t(lang, 'Porozmawiajmy', "Let's talk")}<i>→</i></a>
    </div>
  </section>
</Base>

<style>
  .axis {
    display: flex; align-items: baseline; gap: 16px; margin: 0 0 clamp(24px, 3vw, 40px);
    font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .axis-rule { flex: 1; height: 1px; background: var(--line); }

  .stages { list-style: none; margin: 0; padding: 0; counter-reset: s; }
  .stages li {
    display: grid; grid-template-columns: 72px minmax(0, 1fr);
    gap: clamp(16px, 3vw, 40px);
    padding: clamp(24px, 3vw, 38px) 0;
    border-top: 1px solid var(--line);
  }
  .stages li:last-child { border-bottom: 1px solid var(--line); }
  .stage-n { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; color: #b4b9c2; padding-top: 6px; }
  .stages h2 { margin: 0; font-size: clamp(20px, 2vw, 27px); font-weight: 700; letter-spacing: -0.024em; line-height: 1.2; }
  .stages p { margin: 12px 0 0; max-width: 68ch; font-size: 15.5px; line-height: 1.7; color: #4b5563; }
  .stages .mgmt { color: var(--muted); font-size: 14.5px; }
  @media (max-width: 640px) { .stages li { grid-template-columns: 1fr; gap: 8px; } .stage-n { padding-top: 0; } }

  .band { border-block: 1px solid var(--line); background: #fafafa; padding-block: clamp(56px, 7vw, 104px); }
  .phrases {
    margin-top: clamp(30px, 4vw, 48px);
    display: grid; grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line); border-left: 1px solid var(--line);
  }
  .phrase {
    margin: 0; background: #fff; padding: clamp(18px, 2vw, 26px);
    border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
    font-size: 15px; line-height: 1.55; color: #4b5563;
  }
  @media (max-width: 900px) { .phrases { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .phrases { grid-template-columns: 1fr; } }

  .close-h { margin-top: 16px; max-width: 20ch; }
  .values {
    margin-top: clamp(36px, 4vw, 60px);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(20px, 3vw, 44px);
  }
  .value { border-top: 1px solid var(--line); padding-top: 20px; }
  .value h3 { margin: 0; font-size: 16px; font-weight: 700; letter-spacing: -0.015em; }
  .value p { margin: 10px 0 0; font-size: 14.5px; line-height: 1.6; color: var(--muted); }
  @media (max-width: 900px) { .values { grid-template-columns: repeat(2, 1fr); } }

  .chain {
    list-style: none; margin: clamp(40px, 5vw, 72px) 0 0; padding: 0;
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px;
  }
  .chain li { font-size: clamp(14px, 1.3vw, 17px); font-weight: 700; letter-spacing: -0.01em; }
  .chain li + li::before { content: '→'; color: #c7cbd2; margin-right: 14px; font-weight: 400; }
  .chain-cta { margin-top: clamp(34px, 4vw, 52px); }
</style>
