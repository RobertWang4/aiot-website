---
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import PageHeader from '../../components/inner/PageHeader.astro';
import { pagePhoto } from '../../components/inner/photos';
import { LANGS, getPage, site, t, type Lang } from '../../lib/content';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const p = getPage(lang, 'contact');

// The scraped blocks duplicate the details held in site.json (email / phone /
// address fragments) — render only what the layout below does not already say.
const detailWords = [site.contact.email, site.contact.phone, 'Strzelińska'];
const isDetail = (s: string) => detailWords.some((w) => s.includes(w));
const rest = p.blocks.filter((b) => {
  if (b.type === 'image') return false;
  if (b.type === 'heading') return b.level <= 2 && b.text.trim() !== p.title.trim();
  if (b.type === 'paragraph') return !isDetail(b.text);
  return true;
});
// the trailing "request a quote" heading titles the form
const formHead = rest.find((b) => b.type === 'heading');
const below = rest.filter((b) => b !== formHead);

const tel = site.contact.phone.replace(/\s/g, '');
const subject = encodeURIComponent(t(lang, 'Zapytanie ze strony', 'Enquiry from the website'));

const label = 'block text-[11px] font-semibold uppercase tracking-[.22em] text-muted';
const field =
  'mt-2 w-full border-0 border-b border-navy/20 bg-transparent px-0 py-3 text-[16px] text-navy outline-none transition-colors placeholder:text-muted/45 focus:border-blue';
---
<Base lang={lang} title={p.title} description={p.description} transparentNav>
  <PageHeader
    eyebrow={t(lang, 'Porozmawiajmy', "Let's talk")}
    title={p.title}
    lede={t(
      lang,
      'Audyt, pomiar, wdrożenie czy pełny outsourcing BHP — opisz sytuację, odpowiemy konkretnie.',
      'An audit, a measurement, an implementation or full OHS outsourcing — describe the situation and we will answer with specifics.',
    )}
    image={pagePhoto.contact}
    alt={t(lang, 'Rozmowa kierownictwa zakładu', 'Plant leadership in conversation')}
  />

  <section class="bg-paper px-6 py-[clamp(60px,9vh,115px)] sm:px-10 lg:px-16 xl:px-24">
    <div class="mx-auto grid max-w-[1400px] gap-x-[clamp(40px,7vw,120px)] gap-y-16 lg:grid-cols-[1fr_1fr]">
      <!-- details -->
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[.22em] text-blue">
          {t(lang, 'Dane kontaktowe', 'Contact details')}
        </p>
        <dl class="mt-8">
          <div class="border-t border-navy/12 py-6">
            <dt class={label}>{t(lang, 'E-mail', 'Email')}</dt>
            <dd class="mt-3">
              <a href={`mailto:${site.contact.email}`} class="big">{site.contact.email}</a>
            </dd>
          </div>
          <div class="border-t border-navy/12 py-6">
            <dt class={label}>{t(lang, 'Telefon', 'Phone')}</dt>
            <dd class="mt-3"><a href={`tel:${tel}`} class="big">{site.contact.phone}</a></dd>
          </div>
          <div class="border-y border-navy/12 py-6">
            <dt class={label}>{t(lang, 'Adres', 'Address')}</dt>
            <dd class="mt-3">
              <a href={`https://maps.google.com/?q=${encodeURIComponent(site.contact.address)}`}
                 target="_blank" rel="noreferrer" class="big">{site.contact.address}</a>
            </dd>
          </div>
        </dl>
      </div>

      <!-- form -->
      <div>
        {formHead && formHead.type === 'heading' && (
          <>
            {formHead.eyebrow && (
              <p class="text-[11px] font-semibold uppercase tracking-[.22em] text-blue">{formHead.eyebrow}</p>
            )}
            <h2 class="mt-4 max-w-[16ch] text-[clamp(26px,3.2vw,46px)] font-light leading-[1.04] tracking-[-.035em] text-navy">
              {formHead.text}
            </h2>
          </>
        )}
        <form action={`mailto:${site.contact.email}?subject=${subject}`} method="post" enctype="text/plain"
              class="mt-10 space-y-8">
          <div>
            <label for="f-name" class={label}>{t(lang, 'Imię i nazwisko', 'Name')}</label>
            <input id="f-name" name={t(lang, 'Imie', 'Name')} type="text" required autocomplete="name"
                   placeholder={t(lang, 'Jan Kowalski', 'Jane Doe')} class={field} />
          </div>
          <div>
            <label for="f-email" class={label}>{t(lang, 'Adres e-mail', 'Email address')}</label>
            <input id="f-email" name="Email" type="email" required autocomplete="email"
                   placeholder={t(lang, 'jan@firma.pl', 'jane@company.com')} class={field} />
          </div>
          <div>
            <label for="f-msg" class={label}>{t(lang, 'Wiadomość', 'Message')}</label>
            <textarea id="f-msg" name={t(lang, 'Wiadomosc', 'Message')} rows="5" required
                      placeholder={t(lang, 'Czego dotyczy zapytanie?', 'What is the enquiry about?')}
                      class={`${field} resize-y`}></textarea>
          </div>
          <button type="submit" class="cta">{t(lang, 'Wyślij zapytanie', 'Send enquiry')}<i>→</i></button>
          <p class="text-[12.5px] leading-relaxed text-muted/80">
            {t(
              lang,
              'Formularz otworzy Twój program pocztowy z gotową wiadomością.',
              'The form opens your own mail client with the message ready to send.',
            )}
          </p>
        </form>
      </div>
    </div>

    {below.length > 0 && (
      <div class="mx-auto mt-[clamp(60px,9vh,110px)] max-w-[1400px] border-t border-navy/12 pt-[clamp(40px,6vh,72px)]">
        <Blocks blocks={below} class="max-w-[72ch]" />
      </div>
    )}
  </section>
</Base>

<style>
  .big {
    display: inline-block;
    font-size: clamp(19px, 2.1vw, 30px);
    font-weight: 300; letter-spacing: -.03em; line-height: 1.2;
    color: #0b1b4a;
    transition: color .35s;
  }
  .big:hover { color: #2f6bff; }

  .cta {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 15px 30px; border-radius: 100px; background: #2f6bff; color: #fff;
    font-size: 14px; font-weight: 600; cursor: pointer;
    box-shadow: 0 10px 34px rgba(47,107,255,.34);
    transition: transform .45s cubic-bezier(.16,1,.3,1), box-shadow .45s cubic-bezier(.16,1,.3,1);
  }
  .cta i { font-style: normal; transition: transform .45s cubic-bezier(.16,1,.3,1); }
  .cta:hover { transform: translateY(-2px); box-shadow: 0 16px 44px rgba(47,107,255,.46); }
  .cta:hover i { transform: translateX(4px); }
</style>
