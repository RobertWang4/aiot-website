---
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import PageHeader from '../../components/inner/PageHeader.astro';
import { pagePhoto } from '../../components/inner/photos';
import { LANGS, getPage, t, type Lang } from '../../lib/content';
import type { Block } from '../../lib/content';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const p = getPage(lang, 'about');

type ImageBlock = Extract<Block, { type: 'image' }>;
const marks = p.blocks.filter((b): b is ImageBlock => b.type === 'image');
const text = p.blocks.filter((b) => b.type !== 'image');
// drop the leading heading that only repeats the page title
while (text.length) {
  const first = text[0];
  if (first.type === 'heading' && first.text.trim() === p.title.trim()) text.shift();
  else break;
}
// the header already carries the description — don't print it twice
const key = p.description.replace(/[….]+$/, '').trim().slice(0, 45);
if (key.length > 25) {
  const dup = text.findIndex((b) => b.type === 'paragraph' && b.text.startsWith(key));
  if (dup !== -1) text.splice(dup, 1);
}
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHeader
    eyebrow={t(lang, 'Od 2008 roku', 'Since 2008')}
    title={p.title}
    lede={p.description}
    image={pagePhoto.about}
    alt={t(lang, 'Kierownik zakładu z zespołem produkcyjnym', 'Plant manager with the production team')}
  />

  <section class="sec">
    <div class="wrap"><Blocks blocks={text} class="max-w-[68ch]" /></div>
  </section>

  {marks.length > 0 && (
    <section class="marks">
      <div class="wrap">
        <p class="eyebrow reveal">{t(lang, 'Certyfikaty i akredytacje', 'Certificates and accreditations')}</p>
        <div class="row reveal">
          {marks.map((m) => <img src={m.src} alt={m.alt} loading="lazy" />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .marks { border-top: 1px solid var(--line); padding-block: clamp(44px, 6vw, 80px); }
  .row {
    margin-top: 28px;
    display: flex; flex-wrap: wrap; align-items: center; gap: clamp(26px, 4vw, 60px);
  }
  .row img {
    height: clamp(34px, 4vw, 52px); width: auto; max-width: 150px; object-fit: contain;
    filter: grayscale(1) opacity(0.55); mix-blend-mode: multiply; transition: filter 350ms ease-out;
  }
  .row img:hover { filter: none; }
</style>
