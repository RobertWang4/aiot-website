---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/inner/PageHeader.astro';
import { pagePhoto } from '../../components/inner/photos';
import { LANGS, getPage, t, type Lang, type Block } from '../../lib/content';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const p = getPage(lang, 'clients');
type ImageBlock = Extract<Block, { type: 'image' }>;
const logos = p.blocks.filter((b): b is ImageBlock => b.type === 'image');
const name = (src: string) =>
  decodeURIComponent(src.split('/').pop() ?? '')
    .replace(/\.[a-z0-9]+$/i, '')
    .replace(/^[\d.\s-]+/, '')
    .replace(/[-_]+/g, ' ')
    .trim();
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHeader
    eyebrow={t(lang, `${logos.length} organizacji`, `${logos.length} organisations`)}
    title={p.title}
    lede={t(
      lang,
      'Zakłady produkcyjne, laboratoria i centra logistyczne.',
      'Manufacturing plants, laboratories and logistics centres.',
    )}
    image={pagePhoto.clients}
    alt={t(lang, 'Zespół inżynierów na hali produkcyjnej', 'Engineering team on the shop floor')}
  />

  <section class="sec">
    <div class="wrap grid">
      {logos.map((l) => (
        <div class="cell reveal" title={l.alt || name(l.src)}>
          <img src={l.src} alt={l.alt || name(l.src)} loading="lazy" />
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid; grid-template-columns: repeat(6, 1fr);
    border-top: 1px solid var(--line); border-left: 1px solid var(--line);
  }
  .cell {
    display: flex; align-items: center; justify-content: center;
    aspect-ratio: 16 / 10; padding: clamp(14px, 2vw, 26px);
    border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .cell img {
    max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain;
    mix-blend-mode: multiply; filter: grayscale(1) opacity(0.55);
    transition: filter 0.35s;
  }
  .cell:hover img { filter: none; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
