---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/inner/PageHeader.astro';
import { pagePhoto } from '../../components/inner/photos';
import { LANGS, getPage, t, type Lang, type Block } from '../../lib/content';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const p = getPage(lang, 'clients');
type ImageBlock = Extract<Block, { type: 'image' }>;
const logos = p.blocks.filter((b): b is ImageBlock => b.type === 'image');
const name = (src: string) =>
  decodeURIComponent(src.split('/').pop() ?? '')
    .replace(/\.[a-z0-9]+$/i, '')
    .replace(/^[\d.\s-]+/, '')
    .replace(/[-_]+/g, ' ')
    .trim();
---
<Base lang={lang} title={p.title} description={p.description} transparentNav>
  <PageHeader
    eyebrow={t(lang, `${logos.length} organizacji`, `${logos.length} organisations`)}
    title={p.title}
    lede={t(
      lang,
      'Zakłady produkcyjne, laboratoria i centra logistyczne, które powierzyły nam bezpieczeństwo swoich ludzi i maszyn.',
      'Manufacturing plants, laboratories and logistics centres that trusted us with the safety of their people and their machines.',
    )}
    image={pagePhoto.clients}
    alt={t(lang, 'Zespół inżynierów na hali produkcyjnej', 'Engineering team on the shop floor')}
  />

  <section class="bg-paper px-6 py-[clamp(56px,9vh,110px)] sm:px-10 lg:px-16 xl:px-24">
    <div class="grid grid-cols-2 gap-px border border-navy/12 bg-navy/12 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-6">
      {logos.map((l) => (
        <div class="cell reveal" title={l.alt || name(l.src)}>
          <img src={l.src} alt={l.alt || name(l.src)} loading="lazy" />
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .cell {
    display: flex; align-items: center; justify-content: center;
    aspect-ratio: 16 / 10;
    padding: clamp(16px, 2.2vw, 30px);
    background: #fff;
    transition: background .5s cubic-bezier(.16,1,.3,1);
  }
  .cell img {
    max-width: 100%; max-height: 100%;
    width: auto; height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
    filter: grayscale(1) opacity(.55) contrast(.96);
    transition: filter .5s cubic-bezier(.16,1,.3,1), transform .6s cubic-bezier(.16,1,.3,1);
  }
  .cell:hover img { filter: none; transform: scale(1.04); }
</style>
