---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/inner/PageHeader.astro';
import { LANGS, getPage, t, type Lang, type Block } from '../../lib/content';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const p = getPage(lang, 'gallery');
type ImageBlock = Extract<Block, { type: 'image' }>;
const images = p.blocks.filter((b): b is ImageBlock => b.type === 'image');
const sub = p.blocks.find((b) => b.type === 'heading' && b.text.trim().toLowerCase() !== p.title.trim().toLowerCase());
const lede = p.description || (sub && sub.type === 'heading' ? sub.text : undefined);
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHeader
    eyebrow={t(lang, `${images.length} zdjęć`, `${images.length} photographs`)}
    title={p.title}
    lede={lede}
  />

  <section class="sec">
    <div class="wrap grid">
      {images.map((im, i) => (
        <button class="tile reveal" data-src={im.src} data-alt={im.alt}
                aria-label={im.alt || t(lang, `Powiększ zdjęcie ${i + 1}`, `Enlarge photo ${i + 1}`)}>
          <img src={im.src} alt={im.alt} loading="lazy" />
        </button>
      ))}
    </div>
  </section>

  <dialog id="lb">
    <button id="lb-close" aria-label={t(lang, 'Zamknij', 'Close')}>×</button>
    <img id="lb-img" src="" alt="" />
  </dialog>
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(12px, 1.6vw, 22px); }
  .tile {
    display: block; width: 100%; padding: 0; border: 0; background: var(--surface);
    aspect-ratio: 4 / 3; overflow: hidden; cursor: zoom-in; border-radius: var(--r-sm);
  }
  .tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 350ms ease-out; }
  .tile:hover img, .tile:focus-visible img { transform: scale(1.03); }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }

  #lb {
    width: min(94vw, 1400px); max-width: none; max-height: 92vh;
    padding: 0; border: 0; background: transparent; overflow: visible;
  }
  #lb::backdrop { background: rgba(14, 17, 22, 0.9); }
  #lb img { width: 100%; max-height: 92vh; object-fit: contain; }
  #lb-close {
    position: absolute; top: -36px; right: 0;
    font-size: 28px; line-height: 1; color: rgba(255, 255, 255, 0.75);
    background: none; border: 0; cursor: pointer; transition: color 0.2s;
  }
  #lb-close:hover { color: #fff; }
  @media (max-width: 640px) { #lb-close { top: 6px; right: 8px; color: #fff; } }
</style>

<script>
  const lb = document.getElementById('lb') as HTMLDialogElement | null;
  const img = document.getElementById('lb-img') as HTMLImageElement | null;
  if (lb && img) {
    document.querySelectorAll<HTMLButtonElement>('.tile').forEach((tile) => {
      tile.addEventListener('click', () => {
        img.src = tile.dataset.src ?? '';
        img.alt = tile.dataset.alt ?? '';
        lb.showModal();
      });
    });
    document.getElementById('lb-close')?.addEventListener('click', () => lb.close());
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
</script>
