---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/home/Hero.astro';
import PinBand from '../../components/home/PinBand.astro';
import Stats from '../../components/home/Stats.astro';
import AsiaInvite from '../../components/home/AsiaInvite.astro';
import ServicesRail from '../../components/home/ServicesRail.astro';
import Maturity from '../../components/home/Maturity.astro';
import NoBlame from '../../components/home/NoBlame.astro';
import Clients from '../../components/home/Clients.astro';
import Closing from '../../components/home/Closing.astro';
import { LANGS, getHome, getPage, site, t, type Lang } from '../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const h = getHome(lang);

const clients = getPage(lang, 'clients');
const logos = clients.blocks.filter((b): b is Extract<typeof b, { type: 'image' }> => b.type === 'image').slice(0, 14);
const clientsHeading =
  clients.blocks.find((b) => b.type === 'heading')?.text ?? clients.title;
---
<Base lang={lang} title={h.title} description={h.description} transparentNav>
  <Hero
    lang={lang}
    eyebrow={`${site.brand.name} — ${t(lang, 'od 2008', 'since 2008')}`}
    headline={h.hero.headline}
    ctas={h.hero.ctas}
    img="/img/gallery/robot-welding-technology-in-factory-2026-01-08-00-11-27-utc.jpg"
    alt={t(lang, 'Zrobotyzowane stanowisko spawalnicze w fabryce', 'Robotic welding cell in a factory')}
  />

  <PinBand
    eyebrow={h.services.eyebrow}
    headline={h.services.headline}
    img="/img/gallery/automated-drilling-machines-2026-01-08-23-40-57-utc.jpg"
    alt={t(lang, 'Zautomatyzowana wiertarka podczas pracy', 'Automated drilling machine at work')}
  />

  <Stats lang={lang} />
  <AsiaInvite lang={lang} asia={h.asia} />
  <ServicesRail lang={lang} cards={h.services.cards} />
  <Maturity maturity={h.maturity} />
  <NoBlame noBlame={h.noBlame} />
  <Clients lang={lang} heading={clientsHeading} logos={logos} />
  <Closing lang={lang} closing={h.closing} />
</Base>
