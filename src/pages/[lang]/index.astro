---
import Base from '../../layouts/Base.astro';
import { LANGS, getHome, type Lang } from '../../lib/content';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const h = getHome(lang);
---
<Base lang={lang} title={h.title} description={h.description} transparentNav>
  <section class="flex min-h-screen items-end bg-navy px-6 pb-24 pt-40 text-white">
    <div class="mx-auto w-full max-w-7xl">
      <h1 class="max-w-4xl text-5xl font-bold tracking-tight md:text-7xl">{h.hero.headline}</h1>
      <div class="mt-10 flex gap-4">
        {h.hero.ctas.map((c, i) => <a href={c.href} class:list={['rounded-full px-6 py-3 font-medium', i === 0 ? 'bg-blue text-white' : 'border border-white/40']}>{c.label}</a>)}
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-6 py-24">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue">{h.services.eyebrow}</p>
    <h2 class="mt-3 text-4xl font-bold tracking-tight text-navy">{h.services.headline}</h2>
    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {h.services.cards.map((c, i) => (
        <div class="reveal rounded-2xl bg-mist p-8">
          <span class="text-xs text-blue">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 text-xl font-semibold text-navy">{c.title}</h3>
          <p class="mt-3 text-ink/70">{c.text}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="bg-navy px-6 py-24 text-white">
    <div class="mx-auto max-w-7xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue">{h.maturity.eyebrow}</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight">{h.maturity.headline}</h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-5">
        {h.maturity.stages.map((s, i) => (
          <li class="reveal border-t border-white/20 pt-4" style={`transition-delay:${i * 120}ms`}>
            <h3 class="font-semibold">{s.name}</h3>
            <p class="mt-2 text-sm text-white/70">{s.text}</p>
            <p class="mt-2 text-sm italic text-white/50">{s.management}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-6 py-24 text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue">{h.closing.eyebrow}</p>
    <h2 class="mt-3 text-4xl font-bold tracking-tight text-navy">{h.closing.headline}</h2>
    <p class="mt-8 font-display text-2xl italic text-ink/60">{h.closing.chain.join(' → ')}</p>
  </section>
</Base>
