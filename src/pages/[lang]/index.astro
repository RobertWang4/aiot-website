---
import Base from '../../layouts/Base.astro';
import { AREAS } from '../../lib/areas';
import { LANGS, getHome, getPage, getServiceIndex, t, type Lang, type Block } from '../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const h = getHome(lang);

type ImageBlock = Extract<Block, { type: 'image' }>;
const allLogos = getPage(lang, 'clients').blocks.filter((b): b is ImageBlock => b.type === 'image');
const logos = allLogos.slice(0, 12);

const cats = getServiceIndex(lang).categories;
const serviceCount = cats.reduce((n, c) => n + c.services.length, 0);
const credentials = [
  { k: t(lang, 'Na rynku', 'In business'), v: t(lang, 'Od 2008', 'Since 2008') },
  { k: t(lang, 'System zarządzania', 'Management system'), v: t(lang, 'Certyfikat ISO', 'ISO certified') },
  { k: t(lang, 'Laboratorium', 'Laboratory'), v: t(lang, 'Akredytacja PCA', 'PCA accredited') },
  {
    k: t(lang, 'Zakres', 'Scope'),
    v: t(lang, `${cats.length} dziedzin · ${serviceCount} usług`, `${cats.length} disciplines · ${serviceCount} services`),
  },
];

const areas = AREAS.map((a) => ({ ...a, href: `/${lang}/services/c/${a.categories[0]}/` }));

const hero = '/img/gallery/robot-welding-technology-in-factory-2026-01-08-00-11-27-utc.jpg';
---
<Base lang={lang} title={h.title} description={h.description}>
  <!-- hero band -->
  <section class="hero">
    <img src={hero} alt={t(lang, 'Zrobotyzowane stanowisko spawalnicze', 'Robotic welding cell')} />
    <div class="hero-veil"></div>
    <div class="hero-in wrap">
      <h1 class="hero-title">{h.hero.headline}</h1>
      <a href={`/${lang}/contact/`} class="btn btn-p">{t(lang, 'Porozmawiajmy', "Let's talk")}<i>→</i></a>
    </div>
  </section>

  <!-- credentials -->
  <section class="creds">
    <div class="wrap creds-grid">
      {credentials.map((c) => (
        <div class="cred">
          <p class="cred-k">{c.k}</p>
          <p class="cred-v">{c.v}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- what we do -->
  <section class="sec">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">{t(lang, 'Zakres', 'What we do')}</p>
        <h2 class="h2">{t(lang, 'Trzy obszary, dziesięć dziedzin.', 'Three areas, ten disciplines.')}</h2>
      </div>
      <div class="tiles">
        {areas.map((a) => (
          <a href={a.href} class="tile reveal">
            <span class="tile-shot"><img src={a.photo} alt="" loading="lazy" /></span>
            <h3>{a.title(lang)}</h3>
            <p>{a.line(lang)}</p>
            <span class="tile-more">{t(lang, 'Zobacz', 'View')}<i>→</i></span>
          </a>
        ))}
      </div>
      <a href={`/${lang}/services/`} class="all">{t(lang, 'Cała oferta', 'All services')}<i>→</i></a>
    </div>
  </section>

  <!-- about teaser -->
  <section class="about">
    <div class="wrap about-in reveal">
      <p class="eyebrow">{t(lang, 'O nas', 'About us')}</p>
      <p class="about-line">{t(
        lang,
        'Od 2008 roku prowadzimy zakłady przemysłowe przez bezpieczeństwo maszyn, BHP i kulturę bezpieczeństwa.',
        'Since 2008 we have guided industrial plants through machine safety, OHS and safety culture.',
      )}</p>
      <div class="about-links">
        <a href={`/${lang}/about/`} class="ul">{t(lang, 'O firmie', 'About us')}<i>→</i></a>
        <a href={`/${lang}/safety-culture/`} class="ul">{t(lang, 'Kultura bezpieczeństwa', 'Safety culture')}<i>→</i></a>
      </div>
    </div>
  </section>

  <!-- clients -->
  <section class="sec clients">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">{t(lang, 'Zaufali nam', 'Trusted by')}</p>
        <h2 class="h2">{t(lang, `${allLogos.length} organizacji`, `${allLogos.length} organisations`)}</h2>
      </div>
      <div class="logos reveal">
        {logos.map((l) => <span class="logo"><img src={l.src} alt={l.alt} loading="lazy" /></span>)}
      </div>
      <a href={`/${lang}/clients/`} class="all">{t(lang, 'Wszyscy klienci', 'All clients')}<i>→</i></a>
    </div>
  </section>

  <!-- contact band -->
  <section class="cta-band">
    <div class="wrap cta-in reveal">
      <h2 class="h2">{t(lang, 'Zacznijmy od rozmowy.', 'Start with a conversation.')}</h2>
      <a href={`/${lang}/contact/`} class="btn btn-p">{t(lang, 'Kontakt', 'Contact us')}<i>→</i></a>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero { position: relative; height: clamp(460px, 78vh, 820px); overflow: hidden; background: #f4f5f7; }
  .hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-veil {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.88) 34%, rgba(255, 255, 255, 0.1) 74%, rgba(255, 255, 255, 0) 100%);
  }
  .hero-in {
    position: relative; z-index: 2; height: 100%;
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
    gap: clamp(30px, 4vw, 46px);
  }
  .hero-title {
    margin: 0; max-width: 15ch;
    font-size: clamp(34px, 5.4vw, 76px); font-weight: 700;
    letter-spacing: -0.036em; line-height: 1.02; text-wrap: balance;
  }
  @media (max-width: 700px) {
    .hero { height: clamp(420px, 64vh, 560px); }
    .hero-veil { background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.93) 55%, rgba(255, 255, 255, 0.72) 100%); }
    .hero-title { max-width: none; }
  }

  /* credentials */
  .creds { border-bottom: 1px solid var(--line); }
  .creds-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .cred {
    padding: clamp(24px, 2.6vw, 38px) clamp(16px, 2vw, 34px) clamp(24px, 2.6vw, 38px) 0;
    border-right: 1px solid var(--line);
  }
  .cred:last-child { border-right: 0; }
  .cred + .cred { padding-left: clamp(16px, 2vw, 34px); }
  .cred-k {
    margin: 0; font-size: 11px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .cred-v {
    margin: 12px 0 0; font-size: clamp(15px, 1.35vw, 19px); font-weight: 700;
    letter-spacing: -0.018em; line-height: 1.25;
  }
  @media (max-width: 760px) {
    .creds-grid { grid-template-columns: 1fr 1fr; }
    .cred { padding-right: clamp(14px, 4vw, 26px); }
    .cred:nth-child(odd) { padding-left: 0; }
    .cred:nth-child(even) { padding-left: clamp(14px, 4vw, 26px); border-right: 0; }
    .cred:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }

  /* what we do */
  .head { margin-bottom: clamp(42px, 5vw, 72px); }
  .head .h2 { margin-top: 18px; max-width: 18ch; }
  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.6vw, 40px); }
  .tile { display: block; }
  .tile-shot { display: block; overflow: hidden; background: #f4f5f7; aspect-ratio: 3 / 2; }
  .tile-shot img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
  .tile:hover .tile-shot img { transform: scale(1.04); }
  .tile h3 {
    margin: 26px 0 0; font-size: clamp(19px, 1.8vw, 25px); font-weight: 700;
    letter-spacing: -0.02em; line-height: 1.2;
  }
  .tile p { margin: 9px 0 0; font-size: 14.5px; line-height: 1.6; color: var(--muted); max-width: 32ch; }
  .tile-more {
    display: inline-flex; align-items: center; gap: 7px; margin-top: 16px;
    font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
    transition: color 0.25s;
  }
  .tile-more i { font-style: normal; transition: transform 0.3s var(--ease); }
  .tile:hover .tile-more { color: var(--blue); }
  .tile:hover .tile-more i { transform: translateX(4px); }
  @media (max-width: 860px) { .tiles { grid-template-columns: 1fr; } .tile p { max-width: none; } }

  .all {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: clamp(36px, 4vw, 56px);
    font-size: 13.5px; font-weight: 600; border-bottom: 1px solid var(--line); padding-bottom: 4px;
    transition: color 0.25s, border-color 0.25s;
  }
  .all i { font-style: normal; transition: transform 0.3s var(--ease); }
  .all:hover { color: var(--blue); border-color: var(--blue); }
  .all:hover i { transform: translateX(4px); }

  /* about teaser */
  .about { border-block: 1px solid var(--line); padding-block: clamp(72px, 10vw, 150px); }
  .about-line {
    margin: 22px 0 0; max-width: 24ch;
    font-size: clamp(24px, 3.2vw, 44px); font-weight: 700; letter-spacing: -0.032em; line-height: 1.14;
  }
  .about-links { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 28px; }
  .ul {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 13.5px; font-weight: 600; border-bottom: 1px solid var(--line); padding-bottom: 4px;
    transition: color 0.25s, border-color 0.25s;
  }
  .ul i { font-style: normal; transition: transform 0.3s var(--ease); }
  .ul:hover { color: var(--blue); border-color: var(--blue); }
  .ul:hover i { transform: translateX(4px); }

  /* clients */
  .clients .logos {
    margin-top: clamp(30px, 3vw, 44px);
    display: grid; grid-template-columns: repeat(6, 1fr);
    border: 1px solid var(--line); border-width: 1px 0 0 1px;
  }
  .logo {
    display: flex; align-items: center; justify-content: center;
    aspect-ratio: 16 / 10; padding: clamp(14px, 2vw, 26px);
    border: 1px solid var(--line); border-width: 0 1px 1px 0;
  }
  .logo img {
    max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain;
    mix-blend-mode: multiply; filter: grayscale(1) opacity(0.55);
    transition: filter 0.35s;
  }
  .logo:hover img { filter: none; }
  @media (max-width: 900px) { .clients .logos { grid-template-columns: repeat(3, 1fr); } }

  /* contact band */
  .cta-band { border-top: 1px solid var(--line); padding-block: clamp(72px, 10vw, 140px); }
  .cta-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 26px; }
  .cta-in .h2 { max-width: 16ch; }
</style>
